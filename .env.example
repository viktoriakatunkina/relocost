# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Сайт
NEXT_PUBLIC_SITE_URL=https://relocost.ru

# ЮKassa — подключим на 4-й неделе
YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=

# Unsplash — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Anthropic — для генерации SEO-текстов
ANTHROPIC_API_KEY=

# Чеки НПД: 1 = слать чек самозанятого (включать ТОЛЬКО после активации фискализации в ЛК ЮKassa)
YOKASSA_RECEIPTS=

# Письмо покупателю после оплаты со ссылкой на отчет (lib/purchase-email.ts).
# Без SMTP_* и ACCESS_LINK_SECRET письма не уходят, остальное работает как раньше.
# SMTP_PORT: 465 = SSL, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Отправитель, например: Relocost <hello@relocost.ru> (по умолчанию SMTP_USER)
MAIL_FROM=
# Куда пойдут ответы покупателей (необязательно)
MAIL_REPLY_TO=
# Подпись ссылок доступа: случайная строка от 32 символов. НЕ менять — старые ссылки из писем перестанут работать.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_LINK_SECRET=
